#!@PREFIX@/bin/sh
set -e
# ALTIVEC_LIFECYCLE
case "$1" in
    configure)
        strappy_service start
        if command -v uicache >/dev/null 2>&1; then
            su mobile -c 'uicache -p @PREFIX@/Applications/Strappy.app' >/dev/null 2>&1 || uicache -p '@PREFIX@/Applications/Strappy.app' >/dev/null 2>&1 || su mobile -c uicache >/dev/null 2>&1 || uicache >/dev/null 2>&1 || true
        fi
        ;;
esac
