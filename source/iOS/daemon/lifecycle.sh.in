#!@PREFIX@/bin/sh
# Sourced by package scripts: use the legacy launchctl interface on iOS 5+.
strappy_service() {
    strappy_plist='@PREFIX@/Library/LaunchDaemons/com.altivecintelligence.strappyd.plist'
    strappy_log_dir='@PREFIX@/var/log/strappy'
    case "$1" in
        stop)
            if @PREFIX@/bin/launchctl list com.altivecintelligence.strappyd >/dev/null 2>&1; then
                # Unload may return before the old worker has exited. Never
                # replace its executable/resources while it is still running.
                strappy_pid=$(@PREFIX@/bin/launchctl list com.altivecintelligence.strappyd |
                    while read -r strappy_key strappy_equals strappy_value; do
                        if [ "$strappy_key" = '"PID"' ]; then
                            echo "${strappy_value%;}"
                        fi
                    done)
                @PREFIX@/bin/launchctl unload "$strappy_plist"
                case "$strappy_pid" in
                    ''|*[!0-9]*) ;;
                    *)
                        strappy_wait=0
                        while kill -0 "$strappy_pid" 2>/dev/null; do
                            if [ "$strappy_wait" -ge 15 ]; then
                                echo 'Strappy service did not stop; refusing to replace its files.' >&2
                                return 1
                            fi
                            sleep 1
                            strappy_wait=$((strappy_wait + 1))
                        done
                        ;;
                esac
            fi
            ;;
        start)
            mkdir -p "$strappy_log_dir"
            chown mobile:mobile "$strappy_log_dir"
            chmod 0700 "$strappy_log_dir"
            mkdir -p "/var/mobile/Library/Application Support"
            chown mobile:mobile "/var/mobile/Library/Application Support"
            strappy_service stop
            @PREFIX@/bin/launchctl load "$strappy_plist"
            ;;
    esac
}

# The removable experiment owns the same bundle path. Refuse before unpacking;
# the operator removes that package with dpkg, never by deleting its files.
strappy_provider_preflight() {
    if ! command -v dpkg-query >/dev/null 2>&1; then
        echo 'Strappy: dpkg-query is required to check notification bundle ownership.' >&2
        return 1
    fi
    strappy_query_result=0
    strappy_candidate_status=$(dpkg-query -W -f='${Status}' \
        com.altivecintelligence.strappy.notification-provider-test 2>/dev/null) || strappy_query_result=$?
    case "$strappy_query_result" in
        0) ;;
        1) strappy_candidate_status='' ;; # Package is not in the database.
        *)
            echo 'Strappy: notification package ownership query failed.' >&2
            return 1
            ;;
    esac
    case "$strappy_candidate_status" in
        ''|*' not-installed'|*' config-files') ;;
        *)
            echo 'Strappy: remove com.altivecintelligence.strappy.notification-provider-test with dpkg before installing this package.' >&2
            return 1
            ;;
    esac
}
